rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // docs/tab-setting.js 의 ADMIN 과 같은 이메일
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'roomdoor.lee@gmail.com' && request.auth.token.email_verified == true;
    }
    function isMe(uid) { return request.auth != null && request.auth.uid == uid; }
    function approved(uid) {
      return isMe(uid) && (isAdmin() || get(/databases/$(database)/documents/users/$(uid)).data.approved == true);
    }

    // 가입 신청. 본인은 approved:false 로 한 번만 만들 수 있고, 승인·거절은 관리자만
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasAll(['email', 'name', 'approved'])
        && request.resource.data.keys().hasOnly(['email', 'name', 'approved'])
        && request.resource.data.approved == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
        && request.resource.data.approved is bool;
      allow delete: if isAdmin();

      // 승인된 본인만 읽고 새로 저장한다. 고치기·지우기는 막아 지난 저장본을 지킨다
      match /saves/{save} {
        allow read: if approved(uid);
        // 세 칸이 모두 있어야 한다. 하나라도 빠진 문서가 있으면 목록 화면이 깨진다
        allow create: if approved(uid)
          && request.resource.data.keys().hasAll(['title', 'savedAt', 'data'])
          && request.resource.data.keys().hasOnly(['title', 'savedAt', 'data'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          // toISOString() 모양만 받는다. 아니면 목록에 'Invalid Date' 로 보인다
          && request.resource.data.savedAt is string
          && request.resource.data.savedAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z')
          && request.resource.data.data is string && request.resource.data.data.size() <= 500000;
      }
    }
    // 예전 로그인 없던 /saves 는 규칙이 없어 아무도 못 읽고 못 쓴다
  }
}
